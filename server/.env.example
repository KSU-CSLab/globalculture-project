# KSU Culture Hub — 백엔드 환경변수 설정
# Render 배포 시 아래 값들을 환경변수 패널에 입력하세요.

PORT=5000
NODE_ENV=production

# MongoDB Atlas 연결 URI (무료 M0 클러스터)
# 형식: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ksu_culture?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ksuadmin:YOURPASSWORD@cluster0.xxxxx.mongodb.net/ksu_culture?retryWrites=true&w=majority

# JWT 시크릿 (32자 이상 랜덤 문자열 사용)
JWT_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# 허용 이메일 도메인
ALLOWED_EMAIL_DOMAINS=ks.ac.kr

# 파일 업로드 최대 크기 (MB)
MAX_FILE_SIZE_MB=10

# 프론트엔드 CORS 허용 주소 (쉼표로 여러 개 가능)
CLIENT_ORIGIN=https://ksu-culture-hub.vercel.app,http://localhost:3000

# SMTP 이메일 발송 설정 (Naver 또는 Gmail 등)
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=your_email@naver.com
SMTP_PASS=your_email_app_password

