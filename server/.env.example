# KSU Culture Hub — 백엔드 환경변수 설정
# Render / Railway 배포 시 이 값들을 서비스 환경변수 패널에 입력하세요.

PORT=5000
NODE_ENV=production

# MongoDB Atlas 연결 URI (무료 M0 클러스터)
# 형식: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ksuadmin:YOURPASSWORD@cluster0.xxxxx.mongodb.net/ksu_culture?retryWrites=true&w=majority

# JWT 시크릿 (32자 이상 랜덤 문자열)
JWT_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# 허용 이메일 도메인
ALLOWED_EMAIL_DOMAINS=ks.ac.kr

# 파일 업로드 최대 크기 (MB)
MAX_FILE_SIZE_MB=10

# 프론트엔드 주소 (CORS 허용) — Vercel 배포 URL
CLIENT_ORIGIN=https://ksu-culture-hub.vercel.app
